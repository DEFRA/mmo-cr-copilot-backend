# Every commented variable is optional and shown with the default from src/config.js.
# Uncomment only what you need to override.

# Ingest Authentication
# Required outside local development. Must match INGEST_TOKEN on the dashboard.
INGEST_TOKEN=local-development-ingest-token
# INGEST_MAX_PAYLOAD_BYTES=2097152

# Entra ID authentication
# Required outside local development (startup fails without them).
# To validate real Entra tokens locally, set these and AUTH_DEV_BYPASS=false.
# The backend only validates tokens, so it needs no client secret.
# Directory (tenant) ID, shared by both app registrations.
# ENTRA_TENANT_ID=
# Backend app registration: Application (client) ID as a GUID (the token aud).
# ENTRA_BACKEND_CLIENT_ID=
# Comma-separated client IDs allowed as the token's azp (the dashboard app registration).
# AUTH_ALLOWED_CLIENT_IDS=
# Scope name only (e.g. access_as_user), not the full api:// URI. Must match the dashboard.
# ENTRA_BACKEND_SCOPE=access_as_user
# Exact, case-sensitive group name as emitted in the token's groups claim. Used at
# start-up when no Dashboard Admin mapping exists, and by `npm run db:seed` for its admin row.
# AUTH_BOOTSTRAP_ADMIN_GROUP=AG-Users-CopilotAnalytics-Dashboard-Admin
# AUTH_ROLE_CACHE_TTL_MS=60000
# AUTH_ROLE_CACHE_MAX_ENTRIES=500
# AUTH_CLOCK_TOLERANCE_SECONDS=60
# AUTH_JWKS_TIMEOUT_MS=5000
# AUTH_JWKS_CACHE_MAX_AGE_MS=600000
# AUTH_JWKS_COOLDOWN_MS=30000
# Local development and tests only: accepts "Bearer dev-mock.<base64url JSON claims>".
AUTH_DEV_BYPASS=true

# Environment & Server
# ENVIRONMENT=local
# PORT=3001
# HOST=0.0.0.0
# LOG_LEVEL=info
# LOG_FORMAT=pino-pretty

# MongoDB
# MONGO_URI=mongodb://127.0.0.1:27017/
# MONGO_DATABASE=mmo-cr-copilot-backend
# MONGO_RETRY_WRITES=true
# MONGO_READ_PREFERENCE=primary

# SonarCloud / Code Quality
# Without SONAR_PROJECT_MAP the integration reports itself unconfigured and the
# dashboard hides its panels. It is not a secret, so in deployed environments it
# belongs in cdp-app-config rather than the CDP Portal Secrets tab.
SONAR_PROJECT_MAP={"DEFRA/mmo-cr-copilot-backend":"DEFRA_mmo-cr-copilot-backend","DEFRA/mmo-cr-copilot-dashboard":"DEFRA_mmo-cr-copilot-dashboard", "DEFRA/mmo-cr-external-frontend": "DEFRA_mmo-cr-external-frontend", "DEFRA/mmo-cr-ios": "DEFRA_mmo-cr-ios", "DEFRA/mmo-cr-reference-data-service": "DEFRA_mmo-cr-reference-data-service", "DEFRA/mmo-cr-android": "DEFRA_mmo-cr-android" }
# Only needed for private projects; public ones are read anonymously.
# SONAR_TOKEN=
# SONAR_BASE_URL=https://sonarcloud.io
# SONAR_REQUEST_TIMEOUT_MS=8000
# SONAR_CACHE_TTL_MS=300000

# Platform / CDP (injected in deployed environments)
# HTTP_PROXY=
# TRACING_HEADER=x-cdp-request-id
# SERVICE_VERSION=
