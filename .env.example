# Every commented variable is optional and shown with the default from src/config.js.
# Uncomment only what you need to override.

# Ingest Authentication
# Required outside local development. Must match INGEST_TOKEN on the dashboard.
INGEST_TOKEN=local-development-ingest-token
# INGEST_MAX_PAYLOAD_BYTES=2097152

# Environment & Server
# ENVIRONMENT=local
# PORT=3001
# HOST=0.0.0.0
# LOG_LEVEL=info
# LOG_FORMAT=pino-pretty

# MongoDB
# MONGO_URI=mongodb://127.0.0.1:27017/
# MONGO_DATABASE=mmo-cr-copilot-backend
# MONGO_RETRY_WRITES=true
# MONGO_READ_PREFERENCE=primary

# SonarCloud / Code Quality
# Without SONAR_PROJECT_MAP the integration reports itself unconfigured and the
# dashboard hides its panels. It is not a secret, so in deployed environments it
# belongs in cdp-app-config rather than the CDP Portal Secrets tab.
SONAR_PROJECT_MAP={"DEFRA/mmo-cr-copilot-backend":"DEFRA_mmo-cr-copilot-backend","DEFRA/mmo-cr-copilot-dashboard":"DEFRA_mmo-cr-copilot-dashboard", "DEFRA/mmo-cr-external-frontend": "DEFRA_mmo-cr-external-frontend", "DEFRA/mmo-cr-ios": "DEFRA_mmo-cr-ios", "DEFRA/mmo-cr-reference-data-service": "DEFRA_mmo-cr-reference-data-service", "DEFRA/mmo-cr-android": "DEFRA_mmo-cr-android" }
# Only needed for private projects; public ones are read anonymously.
# SONAR_TOKEN=
# SONAR_BASE_URL=https://sonarcloud.io
# SONAR_REQUEST_TIMEOUT_MS=8000
# SONAR_CACHE_TTL_MS=300000

# Platform / CDP (injected in deployed environments)
# HTTP_PROXY=
# TRACING_HEADER=x-cdp-request-id
# SERVICE_VERSION=
