# Environment & Server
ENVIRONMENT=local
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info
LOG_FORMAT=pino-pretty

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/
MONGO_DATABASE=mmo-cr-copilot-backend
# MONGO_RETRY_WRITES=true
# MONGO_READ_PREFERENCE=primary

# SonarCloud / Code Quality (Optional - panels self-hide if unconfigured)
# JSON mapping of "<git repository>": "<SonarCloud project key>"
SONAR_PROJECT_MAP=
# SONAR_TOKEN=
# SONAR_BASE_URL=https://sonarcloud.io
# SONAR_REQUEST_TIMEOUT_MS=8000
# SONAR_CACHE_TTL_MS=300000

# Ingest Authentication (Required outside local development)
INGEST_TOKEN=local-development-ingest-token
INGEST_MAX_PAYLOAD_BYTES=2097152

# Platform / CDP (Set in deployed environments)
# HTTP_PROXY=
# TRACING_HEADER=x-cdp-request-id
# SERVICE_VERSION=
